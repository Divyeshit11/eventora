PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/eventora
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-output-from-openssl-rand-hex-32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Set TRUST_PROXY=true only behind a trusted proxy and set its exact hop count.
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
