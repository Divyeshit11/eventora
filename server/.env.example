PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/eventora
MONGODB_DB=eventora
CLIENT_URL=http://localhost:5173

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="Eventora <no-reply@example.com>"

JWT_SECRET=replace-with-output-from-openssl-rand-hex-32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Set TRUST_PROXY=true only behind a trusted proxy and set its exact hop count.
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
# Razorpay Test Mode only. Keep the secret and webhook secret server-side.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
